# ==============================================================================
# Offline-First Oracle POS & Inventory Management System - Environment Template
# Copy this file to .env and provide site-specific configuration.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# Flask Environment (development / production / testing)
FLASK_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY

# Oracle Database Configuration (Target: Oracle 19c and above)
# NOTE: DB_SERVICE_NAME is mandatory with no default value (e.g., XEPDB1, ORCLPDB1)
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE_NAME=XEPDB1
DB_USER=isi
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=ISI

# Oracle Data Pump Directory (Must be created in Oracle and granted to DB_USER)
# Example SQL: CREATE DIRECTORY POS_BACKUP_DIR AS 'C:\oradata\backups';
#              GRANT READ, WRITE ON DIRECTORY POS_BACKUP_DIR TO isi;
ORACLE_BACKUP_DIR=POS_BACKUP_DIR
LOCAL_BACKUP_PATH=C:\pos_backups

# Store & Counter Identifiers (MANDATORY - application will refuse to start if omitted)
# TERMINAL_CODE: Identifies site/store location for sync tracking & invoice prefix (e.g., T01, KHI01)
# COUNTER_CODE:  Identifies physical checkout lane/counter (e.g., C01, LANE01).
#                Read by DocCounter for per-lane isolated sequence numbers and by Shift drawer sessions.
TERMINAL_CODE=T01
COUNTER_CODE=C01

# File Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880

# Central Sync Transport Configuration (Local -> Central One-Way Push)
CENTRAL_SYNC_URL=
CENTRAL_SYNC_TOKEN=
CENTRAL_SYNC_SECRET=

# FBR Tax Compliance (Tier-1 Retailer Integration)
# Kept disabled by default; readiness columns and stubs active
FBR_ENABLED=false
POS_REGISTRATION_NO=

# Payment Gateway Configuration (manual / hblpay / easypaisa / jazzcash)
PAYMENT_GATEWAY=manual

# Timezone & Business Rules
BUSINESS_DAY_CUTOFF=04:00
FISCAL_YEAR_START=07-01

# Isolated Test Database Configuration (Required for running test suite)
# MUST NOT match production DB_SERVICE_NAME, DB_USER, or DB_SCHEMA
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=1521
TEST_DB_SERVICE_NAME=XEPDB1
TEST_DB_USER=isi_pos_test
TEST_DB_PASSWORD=CHANGE_ME_TEST
TEST_DB_SCHEMA=ISI_POS_TEST
